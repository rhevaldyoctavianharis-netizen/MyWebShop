<div class="md:flex gap-4">
  <%- include('../../partials/admin-sidebar') %>
  <div class="flex-1">
    <div class="flex justify-between mb-4"><h1 class="text-2xl font-semibold">Produk</h1><a href="/admin/products/new" class="bg-green-700 text-white px-4 py-2 rounded-md">Tambah</a></div>
    <table class="w-full bg-white border border-slate-200 rounded-md text-sm">
      <thead class="bg-slate-100"><tr><th class="p-3 text-left">Nama</th><th class="p-3 text-left">Kategori</th><th class="p-3 text-left">Harga</th><th class="p-3 text-left">Stok</th><th class="p-3 text-left">Status</th><th class="p-3"></th></tr></thead>
      <tbody>
        <% products.forEach((product) => { %>
          <tr class="border-t border-slate-200 hover:bg-slate-50">
            <td class="p-3"><%= product.name %></td><td class="p-3"><%= product.Category?.name || '-' %></td><td class="p-3"><%= product.price %></td><td class="p-3"><%= product.stock %></td><td class="p-3"><%= product.deletedAt ? 'Deleted' : 'Active' %></td>
            <td class="p-3 text-right"><a href="/admin/products/<%= product.id %>/edit" class="text-green-700 mr-2">Edit</a><form method="POST" action="/admin/products/<%= product.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-red-600">Delete</button></form></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
