<div class="md:flex gap-4">
  <%- include('../../partials/admin-sidebar') %>
  <div class="flex-1">
    <h1 class="text-2xl font-semibold mb-4">Manajemen Deposit</h1>
    <form method="GET" class="mb-3"><select name="status" onchange="this.form.submit()" class="border border-slate-200 rounded-md px-3 py-2"><option value="">Semua</option><option value="PENDING" <%= filter==='PENDING'?'selected':''%>>Pending</option><option value="APPROVED" <%= filter==='APPROVED'?'selected':''%>>Approved</option><option value="REJECTED" <%= filter==='REJECTED'?'selected':''%>>Rejected</option></select></form>
    <table class="w-full bg-white border border-slate-200 rounded-md text-sm">
      <thead class="bg-slate-100"><tr><th class="p-3 text-left">User</th><th class="p-3 text-left">Amount</th><th class="p-3 text-left">Method</th><th class="p-3 text-left">Status</th><th class="p-3"></th></tr></thead>
      <tbody>
        <% deposits.forEach((d) => { %>
          <tr class="border-t border-slate-200 hover:bg-slate-50"><td class="p-3"><%= d.User.email %></td><td class="p-3"><%= d.amount %></td><td class="p-3"><%= d.method %></td><td class="p-3"><%= d.status %></td><td class="p-3 text-right"><a class="text-green-700" href="/admin/deposits/<%= d.id %>">Detail</a></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
