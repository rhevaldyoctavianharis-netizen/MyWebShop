<div class="md:flex gap-4">
  <%- include('../../partials/admin-sidebar') %>
  <div class="flex-1">
    <h1 class="text-2xl font-semibold mb-4">Manajemen User</h1>
    <table class="w-full bg-white border border-slate-200 rounded-md text-sm">
      <thead class="bg-slate-100"><tr><th class="p-3 text-left">Username</th><th class="p-3 text-left">Email</th><th class="p-3 text-left">Role</th><th class="p-3 text-left">Saldo</th><th class="p-3 text-left">Aksi</th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr class="border-t border-slate-200 align-top">
            <td class="p-3"><%= u.username %></td><td class="p-3"><%= u.email %></td><td class="p-3"><%= u.role %></td><td class="p-3"><%= u.balance %></td>
            <td class="p-3">
              <form method="POST" action="/admin/users/<%= u.id %>/role" class="flex gap-2 mb-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="role" class="border border-slate-200 rounded-md px-2 py-1"><option value="user" <%= u.role==='user'?'selected':''%>>user</option><option value="admin" <%= u.role==='admin'?'selected':''%>>admin</option></select>
                <button class="text-green-700">Update role</button>
              </form>
              <form method="POST" action="/admin/users/<%= u.id %>/reset-password" class="flex gap-2 mb-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input name="password" placeholder="Password baru" class="border border-slate-200 rounded-md px-2 py-1" required>
                <button class="text-amber-600">Reset password</button>
              </form>
              <form method="POST" action="/admin/users/<%= u.id %>/balance" class="flex gap-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input name="amount" type="number" placeholder="+/- amount" class="border border-slate-200 rounded-md px-2 py-1" required>
                <input name="note" placeholder="Catatan" class="border border-slate-200 rounded-md px-2 py-1">
                <button class="text-slate-900">Adjust saldo</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
