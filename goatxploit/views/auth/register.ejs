<div class="max-w-md mx-auto bg-white border border-slate-200 rounded-md p-6">
  <h1 class="text-xl font-semibold mb-4">Register</h1>
  <form method="POST" action="/register" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input name="username" required placeholder="Username" class="w-full border border-slate-200 rounded-md px-3 py-2" />
    <input name="email" type="email" required placeholder="Email" class="w-full border border-slate-200 rounded-md px-3 py-2" />
    <input name="password" type="password" required minlength="6" placeholder="Password" class="w-full border border-slate-200 rounded-md px-3 py-2" />
    <button class="bg-green-700 text-white px-4 py-2 rounded-md">Daftar</button>
  </form>
</div>
