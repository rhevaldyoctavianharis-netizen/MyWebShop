<div class="max-w-2xl mx-auto bg-white border border-slate-200 rounded-md p-6">
  <h1 class="text-xl font-semibold mb-4">Deposit Credit</h1>
  <div class="text-sm text-slate-600 space-y-1 mb-4">
    <p>BCA: <%= bankAccount || '-' %></p>
    <p>DANA: <%= danaNumber || '-' %></p>
    <% if (qrisImageUrl) { %><p>QRIS: <a href="<%= qrisImageUrl %>" class="text-green-700" target="_blank">Lihat QRIS</a></p><% } %>
  </div>
  <form method="POST" action="/deposit" enctype="multipart/form-data" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="number" name="amount" min="10000" step="1000" required class="w-full border border-slate-200 rounded-md px-3 py-2" placeholder="Nominal (credit)" />
    <select name="method" class="w-full border border-slate-200 rounded-md px-3 py-2" required>
      <option value="BCA">BCA</option><option value="DANA">DANA</option><option value="QRIS">QRIS</option>
    </select>
    <input type="file" name="proof" accept="image/png,image/jpeg" required class="w-full border border-slate-200 rounded-md px-3 py-2" />
    <button class="bg-green-700 text-white px-4 py-2 rounded-md">Kirim Deposit</button>
  </form>
</div>
