<h1 class="text-2xl font-semibold mb-4">Riwayat Deposit</h1>
<table class="w-full bg-white border border-slate-200 rounded-md overflow-hidden text-sm">
  <thead class="bg-slate-100"><tr><th class="p-3 text-left">Tanggal</th><th class="p-3 text-left">Amount</th><th class="p-3 text-left">Method</th><th class="p-3 text-left">Status</th><th class="p-3 text-left">Catatan</th></tr></thead>
  <tbody>
    <% deposits.forEach((d) => { %>
      <tr class="border-t border-slate-200 hover:bg-slate-50">
        <td class="p-3"><%= new Date(d.createdAt).toLocaleString() %></td>
        <td class="p-3"><%= d.amount %></td>
        <td class="p-3"><%= d.method %></td>
        <td class="p-3"><span class="px-2 py-1 rounded text-xs <%= d.status === 'APPROVED' ? 'bg-green-100 text-green-700' : d.status === 'REJECTED' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700' %>"><%= d.status %></span></td>
        <td class="p-3"><%= d.note || '-' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
